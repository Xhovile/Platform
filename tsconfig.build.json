{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "auth/passkeys/src/**/*.ts",
    "rate-limit/src/**/*.ts",
    "rate-limit/express/**/*.ts",
    "rate-limit/redis/**/*.ts",
    "rate-limit/test/**/*.ts"
  ]
}
