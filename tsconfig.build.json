{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "auth/passkeys/src/**/*.ts",
    "auth/otp/src/**/*.ts",
    "auth/otp/test/**/*.ts",
    "rate-limit/src/**/*.ts",
    "rate-limit/express/**/*.ts",
    "rate-limit/redis/**/*.ts",
    "rate-limit/test/**/*.ts",
    "cache/src/**/*.ts",
    "cache/browser/**/*.ts",
    "cache/test/**/*.ts",
    "payments/server/modules/payments/direct-card.ts",
    "payments/server/modules/payments/paychangu.card.ts",
    "payments/server/modules/payments/paychangu.card.contracts.ts",
    "payments/server/modules/payments/paychangu.card.schema.ts",
    "payments/server/modules/payments/paychangu.card.repository.ts",
    "payments/server/modules/payments/paychangu.card.service.ts",
    "payments/server/modules/payments/paychangu.card.routes.ts"
  ]
}
